# Node 24+. All secrets stay on the server. Do not use VITE_ for secrets.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Hosted Postgres (Supabase transaction pooler / Neon). Required on Vercel.
DATABASE_URL=
# Embedded Postgres for local development only, using the same SQL.
LOCAL_DATABASE_PATH=./data/postgres
# simulation or sandbox. There is intentionally no live-money mode.
PAYMENT_MODE=simulation
DEMO_ENABLED=true
# Optional: enable real model planning. Without a key, the labeled local planner is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required only when PAYMENT_MODE=sandbox. Demo sessions remain simulated.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Set NODE_ENV=production and APP_ORIGIN to your HTTPS origin for deployment.
# Production requires DEMO_ENABLED to be explicitly set; never expose local data publicly.
